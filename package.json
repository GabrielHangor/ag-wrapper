{
  "name": "ag-datagrid-wrapper",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run generate:types",
    "generate:types": "vue-tsc --declaration --emitDeclarationOnly --outdir ./dist",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "ag-grid-community": "^31.0.0",
    "ag-grid-enterprise": "^31.0.0",
    "ag-grid-vue3": "^31.0.0",
    "lodash": "^4.17.21",
    "vue": "^3.3.11"
  },
  "devDependencies": {
    "@babel/types": "^7.23.4",
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/lodash": "^4.14.202",
    "@types/node": "^18.18.5",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "npm-run-all2": "^6.1.1",
    "prettier": "^3.0.3",
    "typescript": "~5.2.0",
    "vite": "^4.4.11",
    "vite-plugin-dts": "^3.6.3",
    "vue-tsc": "^1.8.19"
  },
  "main": "./dist/TestComponent.umd.cjs",
  "module": "./dist/TestComponent.js",
  "exports": {
    ".": {
      "import": "./dist/TestComponent.js",
      "require": "./dist/TestComponent.umd.cjs",
      "types": "./dist/src/lib/index.d.ts"
    }
  }
}
